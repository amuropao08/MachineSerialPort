<Window x:Class="MachineSerialPort.OTPWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MachineSerialPort"
        mc:Ignorable="d"
        Title="Verify OTP" Height="250" Width="350" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Enter the 6-digit code sent to your email" Margin="0,0,0,10" TextAlignment="Center"/>
        <TextBox x:Name="txtOtpInput" FontSize="24" HorizontalContentAlignment="Center" MaxLength="6" Margin="0,0,0,10"/>

        <TextBlock x:Name="lblTimer" Text="Time remaining: 5:00" Foreground="Red" HorizontalAlignment="Center"/>

        <Button x:Name="btnVerify" Content="Verify Code" Click="BtnVerify_Click" Margin="0,15,0,5" Height="30"/>

        <Button x:Name="btnResend" Content="Resend Code" Click="BtnResend_Click" 
                Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand" Visibility="Collapsed"/>
    </StackPanel>
</Window>
