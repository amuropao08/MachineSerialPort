<Window x:Class="MachineSerialPort.GeneralSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MachineSerialPort"
        mc:Ignorable="d"
        Title="Settings" Height="290" Width="475"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Client" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <ComboBox x:Name="ClientComboBox" Grid.Column="2" Grid.Row="0" Height="25" HorizontalAlignment="Left"
          ItemsSource="{Binding SelectedClients}" SelectedItem="{Binding SelectedClient}" />

        <Label Content="OTP Request Email" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBox Grid.Column="2" Grid.Row="2" Height="25" HorizontalAlignment="Left" Text="{Binding OTPRequestEmail}" Width="250"/>

        <Label Content="Packing" Grid.Column="0" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <CheckBox Grid.Column="2" Grid.Row="4" IsChecked="{Binding IsPackingEnable}" />

        <Label Content="Test Send Data Button" Grid.Column="0" Grid.Row="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <CheckBox Content="Show" Grid.Column="2" Grid.Row="6" IsChecked="{Binding IsShowTestSendDataButton}" />

        <Button Command="{Binding SaveCommand}" Content="Save" Grid.Column="2" Grid.Row="8" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Window>
