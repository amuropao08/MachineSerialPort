<Window x:Class="MachineSerialPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:root="clr-namespace:MachineSerialPort"
        xmlns:local="clr-namespace:MachineSerialPort.Helpers"
        mc:Ignorable="d"
        Closing="Window_Closing"
        FocusManager.FocusedElement="{Binding ElementName=txtOrderNo}"
        Loaded="Window_Loaded"
        Title="Leather Measurement" Height="800" Width="1250">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Storyboard x:Key="PausePulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.4" Duration="0:0:0.8"
                         AutoReverse="True" />
        </Storyboard>

        <Style x:Key="PauseButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="Crimson" />
                    <Setter Property="BorderBrush" Value="Crimson" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PausePulseAnimation}" Name="PulseStoryboard" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="False">
                    <Setter Property="Background" Value="ForestGreen" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost DialogMargin="16" Identifier="RootDialog">
        <Grid Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="275"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="275"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Row 1-->
            <Menu Grid.ColumnSpan="12" Grid.Row="0" Background="#F0F0F0" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,0,0,0">
                <MenuItem Header="_General">
                    <MenuItem Click="GeneralSettings_Click" Header="_GeneralSettings" />
                    <MenuItem Click="Reprint_Click" Header="_Reprint" />
                    <Separator />
                    <MenuItem Click="Exit_Click" Header="_Exit" />
                </MenuItem>
                <MenuItem Header="_File">
                    <MenuItem Header="_Save Session (Manual)" Command="{Binding SaveManualCommand}" Icon="{materialDesign:PackIcon Kind=ContentSave}" />
                    <MenuItem Header="_Load Session" Command="{Binding LoadManualCommand}" Icon="{materialDesign:PackIcon Kind=FolderOpen}" />
                    <Separator />
                </MenuItem>
            </Menu>

            <!--Row 2-->
            <TextBlock FontSize="30" FontWeight="Bold" Grid.ColumnSpan="12" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Text="{Binding CurrentClient}" VerticalAlignment="Center" Margin="0,0,0,0"/>

            <!--Row 3 Col 1-->
            <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Text="Order No." VerticalAlignment="Center" />

            <!--Row 3 Col 3-->
            <Grid Grid.Row="2" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox
        Grid.Column="0"
        IsEnabled="{Binding IsReadyToSearchOrder}"
        local:FocusHelper.IsFocused="{Binding IsFocused}"
        MaxLength="12"
        x:Name="txtOrderNo"
        Text="{
            Binding OrderNo,
            UpdateSourceTrigger=PropertyChanged
        }"
        VerticalContentAlignment="Center"
        Width="150">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction 
    Command="{Binding GetOrderInfoCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <TextBox.InputBindings>
                        <KeyBinding
                Key="Return" 
                Command="{Binding GetOrderInfoCommand}"
                CommandParameter="{
                    Binding ElementName=txtOrderNo,
                    Path=Text
                }" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button
        Command="{Binding GetOrderInfoCommand}"
        Content="Search"
        Grid.Column="2"
        IsEnabled="{Binding IsReadyToSearchOrder}" />
            </Grid>

            <!--Row 3 Col 5-->
            <TextBlock Grid.Row="2" Grid.Column="4" HorizontalAlignment="Right" Text="Select Port" VerticalAlignment="Center" />

            <!--Row 3 Col 7-->
            <Grid Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox
        x:Name="PortComboBox"
        Grid.Column="0"
        HorizontalAlignment="Left"
        IsEnabled="{Binding IsToggleConnected}"
        ItemsSource="{Binding AvailablePorts}"
        SelectedItem="{Binding SelectedPortName}"/>
                <Button
        Content="Refresh Ports"
        Command="{Binding RefreshPortsCommand}"
        Grid.Column="2"
        HorizontalAlignment="Right"
        IsEnabled="{Binding IsToggleConnected}"/>
            </Grid>

            <!--Row 3 Col 10-->
            <Grid Grid.Row="2" Grid.Column="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="67"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="Baud Rate" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" HorizontalAlignment="Center" IsEnabled="{Binding IsToggleConnected}" Text="{Binding BaudRate}" />
                <Button Grid.Column="5" Content="{Binding ConnectionButtonText}" Command="{Binding ToggleConnectionCommand}" HorizontalAlignment="Left" IsEnabled="{Binding IsToggleConnected}" />
            </Grid>

            <!--Row 5 Col 1-->
            <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" Text="Material No." VerticalAlignment="Center" />

            <!--Row 5 Col 3-->
            <TextBox Grid.Row="4" Grid.Column="2" IsReadOnly="True" Text="{Binding MatNo}" />

            <!--Row 5 Col 4-->
            <Grid Grid.Row="4" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" HorizontalAlignment="Right" Text="Unit" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" IsReadOnly="True" Text="{Binding Unit}" />
            </Grid>

            <!--Row 5 Col 5-->
            <TextBlock FontSize="14" FontWeight="SemiBold" Grid.Row="4" Grid.Column="4" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Unknown State" />
                        <Setter Property="Foreground" Value="Gray" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.Connected}">
                                <Setter Property="Text" Value="CONNECTED" />
                                <Setter Property="Foreground" Value="BlueViolet" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.Disconnected}">
                                <Setter Property="Text" Value="NOT CONNECTED" />
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.Ready}">
                                <Setter Property="Text" Value="READY" />
                                <Setter Property="Foreground" Value="Green" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.ConfirmStartMeasuring}">
                                <Setter Property="Text" Value="STARTING... PLEASE CONFIRM" />
                                <Setter Property="Foreground" Value="OrangeRed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.StartMeasuring}">
                                <Setter Property="Text" Value="MEASURING..." />
                                <Setter Property="Foreground" Value="Orange" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.ConfirmCancel}">
                                <Setter Property="Text" Value="CANCELLING... PLEASE CONFIRM" />
                                <Setter Property="Foreground" Value="MediumVioletRed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.ConfirmStopMeasuring}">
                                <Setter Property="Text" Value="STOPPING... PLEASE CONFIRM" />
                                <Setter Property="Foreground" Value="DarkRed" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.StopMeasuring}">
                                <Setter Property="Text" Value="WAIT TO SAVE DATA" />
                                <Setter Property="Foreground" Value="SaddleBrown" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static root:DeviceState.Saved}">
                                <Setter Property="Text" Value="DATA SAVED" />
                                <Setter Property="Foreground" Value="Blue" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <!--Row 5 Col 9-->
            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{Binding TextPackingColor}" Grid.Row="4" Grid.RowSpan="2" Grid.Column="8" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TextPackingStatus}" />

            <!--Row 6 Col 1-->
            <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right" Text="Mat. Desc." VerticalAlignment="Center" />

            <!--Row 6 Col 3-->
            <TextBox Grid.Row="5" Grid.Column="2" IsReadOnly="True" Text="{Binding MatDesc}" />

            <!--Row 7 Col 1-->
            <TextBlock Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right" Text="Color Article" VerticalAlignment="Center" />

            <!--Row 7 Col 3-->
            <TextBox Grid.Row="6" Grid.Column="2" IsReadOnly="True" Text="{Binding ColorArticle}" />

            <!--Row 7 Col 5-->
            <TextBlock Grid.Row="6" Grid.Column="4" HorizontalAlignment="Right" Text="Leather Area" VerticalAlignment="Center" />

            <!--Row 7 Col 7-->
            <DataGrid
    AutoGenerateColumns="False"
    CanUserAddRows="False"
    Grid.Row="6"
    Grid.RowSpan="12"
    Grid.Column="6"
    HorizontalAlignment="Left"
    ItemsSource="{Binding Leather}"
    local:ScrollHelper.ScrollToItem="{Binding SelectedLeather}"
    Name="leatherDataGrid"
    SelectedItem="{Binding SelectedLeather}">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="77">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <CheckBox
                            IsChecked="{
                                Binding DataContext.IsAllSelected,
                                RelativeSource={RelativeSource AncestorType=DataGrid}
                            }"
                            VerticalAlignment="Center" />
                                    <TextBlock Text="All" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    IsChecked="{
                                        Binding IsSelected,
                                        UpdateSourceTrigger=PropertyChanged
                                    }"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank, Mode=TwoWay}" Width="63">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Area" Binding="{Binding Area, Mode=TwoWay, StringFormat=N3}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--Row 7 Col 9-->
            <TextBlock Grid.Row="6" Grid.Column="8" HorizontalAlignment="Right" Text="Packing" VerticalAlignment="Center" Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!--Row 7 Col 11-->
            <DataGrid
    AutoGenerateColumns="False"
    CanUserAddRows="False"
    Grid.RowSpan="10"
    Grid.Row="6"
    Grid.Column="10"
    ItemsSource="{Binding PackingLeather}"
    local:ScrollHelper.ScrollToItem="{Binding SelectedPackingLeather}"
    Name="packingDataGrid"
    SelectedItem="{Binding SelectedPackingLeather}"
                Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rank" Binding="{Binding PackingRank}" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Area" Binding="{Binding Area, StringFormat=N3}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--Row 8 Col 1-->
            <TextBlock Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right" Text="Operation" VerticalAlignment="Center" />

            <!--Row 8 Col 3-->
            <Grid Grid.Row="7" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding OperNo}" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="Confirm Type" VerticalAlignment="Center" Visibility="Hidden"/>
                <ComboBox Grid.Column="3" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding ConfirmTypes}" Name="cmbConfirmType" SelectedItem="{Binding SelectedConfirmType}" Visibility="Hidden" />
            </Grid>

            <!--Row 9 Col 1-->
            <TextBlock Grid.Row="8" Grid.Column="0" HorizontalAlignment="Right" Text="Personnel No." VerticalAlignment="Center" />

            <!--Row 9 Col 3-->
            <ComboBox Grid.Row="8" Grid.Column="2" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding Personnels}" Name="cmbPersonnel" SelectedItem="{Binding SelectedPersonnel}" />

            <!--Row 9 Col 9-->
            <Button x:Name="RequestAddDataButton"
                    Click="Request_Click"
                    Content="Request"
                    Grid.Row="8"
                    Grid.Column="8"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanProcessData}" />

            <!--Row 10 Col 1-->
            <TextBlock Grid.Row="9" Grid.Column="0" HorizontalAlignment="Right" Text="Wage Group" VerticalAlignment="Center" />

            <!--Row 10 Col 3-->
            <ComboBox Grid.Row="9" Grid.Column="2" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding WageGroups}" Name="cmbWageGroup" SelectedItem="{Binding SelectedWageGroup}" />

            <!--Row 10 Col 4-->
            <CheckBox
    Content="Packing"
    Grid.Row="9"
    Grid.Column="3"
    HorizontalAlignment="Center"
    IsChecked="{Binding IsPacking}"
    IsEnabled="{Binding IsPackingAllowed}"
    Name="chkPacking"
    ToolTipService.ShowOnDisabled="True"
    VerticalAlignment="Center">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <DataTrigger
                    Binding="{
                        Binding ElementName=cmbLeatherGrade,
                        Path=Text
                    }"
                    Value="NC">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTip" Value="Packing is not available for NC grade leather."/>
                            </DataTrigger>
                            <DataTrigger
                    Binding="{
                        Binding ElementName=cmbLeatherGrade,
                        Path=Text
                    }"
                    Value="NG">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTip" Value="Packing is not available for NG grade leather."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <!--Row 10 Col 9-->
            <TextBox x:Name="AddMeasureDataText"
                     DataObject.Pasting="DecimalTextBox_Pasting"
                     Grid.Row="9"
                     Grid.Column="8"
                     HorizontalContentAlignment="Center"
                     IsEnabled="{Binding CanAddData}"
                     PreviewKeyDown="DecimalTextBox_PreviewKeyDown"
                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                     Text="{Binding AddMeasureData, UpdateSourceTrigger=PropertyChanged}" />

            <!--Row 12 Col 1-->
            <TextBlock Grid.Row="11" Grid.Column="0" HorizontalAlignment="Right" Text="PUn UnE" VerticalAlignment="Center"/>

            <!--Row 12 Col 3-->
            <ComboBox Grid.Row="11" Grid.Column="2" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding ParallelUnits}" Name="cmbParallelUnit" SelectedItem="{Binding SelectedParallelUnit}" />

            <!--Row 12 Col 9-->
            <Button x:Name="AddDataButton"
                    Command="{Binding AddItemCommand}"
                    Content="Add"
                    Grid.Row="11"
                    Grid.Column="8"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanAddData}" />

            <!--Row 13 Col 1-->
            <TextBlock Grid.Row="12" Grid.Column="0" HorizontalAlignment="Right" Text="Stor. Loc." VerticalAlignment="Center"/>

            <!--Row 13 Col 3-->
            <ComboBox Grid.Row="12" Grid.Column="2" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding StorageLocations}" Name="cmbStoragLocation" SelectedItem="{Binding SelectedStorageLocation}" />

            <!--Row 14 Col 1-->
            <TextBlock Grid.Row="13" Grid.Column="0" HorizontalAlignment="Right" Text="Grade" VerticalAlignment="Center"/>

            <!--Row 14 Col 3-->
            <Grid Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" IsEnabled="{Binding IsReadyToEditSettings}" ItemsSource="{Binding LeatherGrades}" Name="cmbLeatherGrade" SelectedItem="{Binding SelectedGrade}" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="NG Reason" VerticalAlignment="Center"/>
                <ComboBox
        Grid.Column="4"
        ItemsSource="{Binding NGReasons}"
        IsEnabled="{Binding IsNGReasonEnabled}"
        Name="cmbNGReason"
        SelectedItem="{Binding SelectedNGReason}" />
            </Grid>

            <!--Row 16 Col 9-->
            <Button x:Name="DeleteDataButton"
                    Command="{Binding DeleteItemCommand}"
                    Content="Delete"
                    Grid.Row="15"
                    Grid.Column="8"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding CanProcessData}"
                    VerticalAlignment="Bottom" />

            <!--Row 16 Col 3-->
            <Grid Grid.Row="15" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Start" Command="{Binding StartCommand}" Grid.Column="0" HorizontalAlignment="Left" IsEnabled="{Binding IsReadyToStart}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Grid.Column="2" HorizontalAlignment="Center" IsEnabled="{Binding IsMeasuring}" />
                <Button Content="Stop" Command="{Binding StopCommand}" Grid.Column="4" HorizontalAlignment="Right" IsEnabled="{Binding IsMeasuring}" />
            </Grid>

            <!--Row 18 Col 3-->
            <Grid Grid.Row="17" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Name="btnSave" Content="Save" Command="{Binding SaveCommand}" Grid.Column="0" HorizontalAlignment="Left" IsEnabled="{Binding IsReadyToSave}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Finalize the current round via 'Next' before saving."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Print A5" Command="{Binding PrintA5Command}" Grid.Column="2" HorizontalAlignment="Center" />
                <Button Content="Print A4" Command="{Binding PrintA4Command}" Grid.Column="4" HorizontalAlignment="Right" />
            </Grid>

            <!--Row 18 Col 9-->
            <TextBlock Grid.Column="8" Grid.Row="17" HorizontalAlignment="Right" Text="Total" VerticalAlignment="Center" Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!--Row 18 Col 11-->
            <TextBox x:Name="txtPackingTotalArea" Grid.Column="10" Grid.Row="17" HorizontalContentAlignment="Right" IsReadOnly="True" Text="{Binding TxtPackingTotalArea}" Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!--Row 20 Col 3-->
            <Grid Grid.Row="19" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="New PDO" Command="{Binding ResetCommand}" Grid.Column="0" HorizontalAlignment="Left" />
                <Button
        x:Name="TestSendDataButton"
        Command="{Binding TestSendDataCommand}"
        Content="Test Send Data"
        Grid.Column="2"
        HorizontalAlignment="Right"
        Visibility="{
            Binding ShowTestSendDataButton,
            Converter={StaticResource BoolToVisibilityConverter}
        }" />
            </Grid>

            <!--Row 20 Col 5-->
            <TextBlock Grid.Row="19" Grid.Column="4" HorizontalAlignment="Right" Text="Total" VerticalAlignment="Center"/>

            <!--Row 20 Col 7-->
            <TextBox x:Name="txtTotalArea" Grid.Row="19" Grid.Column="6" HorizontalContentAlignment="Right" IsReadOnly="True" Text="{Binding TxtTotalArea}" />

            <!--Row 20 Col 11-->
            <Grid Grid.Row="19" Grid.Column="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--<Button x:Name="PrintPackingButton" Command="{Binding PrintPackingCommand}" Content="Print" Grid.Column="0" HorizontalAlignment="Left" Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}" />-->
                <Button x:Name="NextPackingButton"
                        Command="{Binding NextPackingCommand}"
                        Content="Pack"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding CanProcessData}"
                        Visibility="{Binding IsPacking, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!--Row 22 Col 1-->
            <StatusBar Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="21">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseSync" Width="14" Height="14" VerticalAlignment="Center" Foreground="Gray"/>
                        <TextBlock Text="{Binding StatusMessage}" 
               Foreground="Gray" 
               FontSize="12" 
               Margin="5,0,0,0"/>
                    </StackPanel>
                </StatusBarItem>

                <Separator Foreground="#DDDDDD" />

                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="DarkBlue"/>
                        <TextBlock Text="{Binding SessionDuration}" 
               Foreground="DarkBlue" 
               FontSize="12" 
               FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
               Margin="5,0,10,0"/>

                        <Button Command="{Binding TogglePauseCommand}"
                                Margin="0,0,5,0"
            Style="{StaticResource PauseButtonStyle}" >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding IsPaused, Converter={StaticResource PauseIconConverter}}" 
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding IsPaused, Converter={StaticResource PauseTextConverter}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!--Progress Bar-->
            <Border Grid.Row="0" 
    Grid.Column="0" 
    Grid.RowSpan="22" 
    Grid.ColumnSpan="12"
    Background="#A0FFFFFF" 
    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">

                <ProgressBar IsIndeterminate="True" 
             Width="200" 
             Height="15" 
             HorizontalAlignment="Center" 
