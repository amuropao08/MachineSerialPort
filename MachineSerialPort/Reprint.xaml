<Window x:Class="MachineSerialPort.Reprint"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MachineSerialPort"
        mc:Ignorable="d"
        Title="Reprint" Height="300" Width="500"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="30">
        <TextBlock DockPanel.Dock="Top" Text="Reprint Form" FontSize="18" Margin="0,0,0,15"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Order No." VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="5" Padding="3" Text="{Binding ReprintOrderNo}" Width="150"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Doc. Year" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="5" Padding="3" Text="{Binding ReprintDocYear}" Width="75"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Mat. Doc." VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="5" Padding="3" Text="{Binding MatDocFrom}" Width="150"/>
            <Label Content="to" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="167,5,5,5"/>
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="200,5,5,5" Padding="3" Text="{Binding MatDocTo}" Width="150"/>

            <Button Command="{Binding ReprintA5Command}" Content="A5" Grid.Column="1" Grid.Row="3" Height="30" HorizontalAlignment="Left" Margin="5,10,0,0" Width="50"/>
            <Button Command="{Binding ReprintA4Command}" Content="A4" Grid.Column="1" Grid.Row="3" Height="30" HorizontalAlignment="Left" Margin="80,10,0,0" Width="50"/>
        </Grid>
    </DockPanel>
</Window>
